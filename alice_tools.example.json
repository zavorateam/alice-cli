{
  "shell": {
    "enabled": true,
    "strict": false,
    "blocked_commands": [
      "rm", "mv", "sudo", "su", "dd", "mkfs",
      "chmod", "chown", "chattr", "chgrp",
      "kill", "killall", "pkill",
      "shutdown", "reboot", "halt", "init",
      "systemctl", "launchctl",
      "passwd", "useradd", "userdel", "usermod",
      "iptables", "pfctl", "mount", "umount"
    ],
    "working_directory": "/tmp",
    "timeout_sec": 120
  },
  "files": {
    "root": "~",
    "read_enabled": true,
    "list_enabled": true,
    "attach_enabled": true,
    "attach_max_bytes": 20971520,
    "write_enabled": true,
    "write_root": "~",
    "write_max_bytes": 10485760
  },
  "meeseeks": {
    "enabled": true,
    "max_depth": 3,
    "max_concurrent": 5,
    "bridge_max_iterations": 8
  },
  "mcpServers": {
    "fetch": {
      "command": "uvx",
      "args": ["mcp-server-fetch"]
    }
  }
}